# Upstream SMTP relay host, for example [smtp.example.com]:587
RELAYHOST=[smtp.example.com]:587

# Upstream auth credentials (do not commit real values)
RELAYHOST_USERNAME=replace-with-username
RELAYHOST_PASSWORD=replace-with-password

# Comma-separated list of sender domains allowed by this relay
ALLOWED_SENDER_DOMAINS=example.com

# log format: text or json
LOG_FORMAT=text

# Shared SMTP network (small subnet with reserve capacity)
SMTP_RELAY_SUBNET=172.30.40.0/27
SMTP_RELAY_GATEWAY=172.30.40.1
